+/*
+ * +58Express — Modern Yellow Lab
+ * Local-only visual experiment. main.js enables this class exclusively on
+ * localhost/127.0.0.1. Add ?classic=1 to compare with the current UI.
+ */
+
+html.modern-yellow-lab {
+  --lab-bg: #0c0d12;
+  --lab-bg-soft: #12141b;
+  --lab-panel: rgba(25, 27, 36, .92);
+  --lab-panel-strong: #1a1c25;
+  --lab-panel-warm: #242116;
+  --lab-line: rgba(255, 255, 255, .105);
+  --lab-line-bright: rgba(255, 210, 31, .34);
+  --lab-yellow: #ffd21f;
+  --lab-yellow-2: #ffb800;
+  --lab-yellow-soft: rgba(255, 210, 31, .13);
+  --lab-white: #f7f7fa;
+  --lab-muted: #9699a6;
+  --lab-muted-2: #686b77;
+  --lab-green: #55e29a;
+  --lab-red: #ff6878;
+  --lab-blue: #63c9ff;
+  --lab-radius-xl: 30px;
+  --lab-radius-lg: 23px;
+  --lab-radius-md: 17px;
+  --lab-shadow: 0 24px 70px rgba(0, 0, 0, .42);
+  color-scheme: dark;
+  background: var(--lab-bg);
+}
+
+html.modern-yellow-lab,
+html.modern-yellow-lab body,
+html.modern-yellow-lab #app {
+  min-height: 100%;
+  background:
+    radial-gradient(circle at 50% -10%, rgba(255, 210, 31, .055), transparent 34%),
+    var(--lab-bg) !important;
+  color: var(--lab-white);
+}
+
+html.modern-yellow-lab body {
+  font-family: 'Outfit', system-ui, sans-serif;
+  letter-spacing: -.01em;
+}
+
+html.modern-yellow-lab * {
+  scrollbar-color: rgba(255, 210, 31, .28) transparent;
+}
+
+html.modern-yellow-lab :is(button, input, select, textarea) {
+  font: inherit;
+}
+
+html.modern-yellow-lab :is(button, a, input, select, textarea):focus-visible {
+  outline: 2px solid var(--lab-yellow) !important;
+  outline-offset: 3px;
+}
+
+html.modern-yellow-lab :is(.glass-panel, .diorama-card-3d, .ops-panel, .finance-card,
+  .wallet-real-history, .real-profile-card, .passenger-history-card,
