VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Backend
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://plus58express.vercel.app
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
DATA_FILE=/data/plus58express.sqlite
UPLOAD_DIR=/data/private-uploads
DISABLE_LEGACY_DEMO_USERS=true

# PostgreSQL administrado por Supabase. En Railway usa el Session pooler
# (puerto 5432) si la red no llega al endpoint IPv6 directo.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DATABASE_SSL=require
DATABASE_POOL_MAX=10

# Clave publica del Maps JavaScript API de Google. SOLO el nombre: el valor se
# configura en el entorno del despliegue (Vercel) y nunca se escribe aqui.
# Esta clave es visible en el navegador por diseno; su proteccion real son las
# restricciones en Google Cloud: referentes HTTP (el dominio de produccion y
# localhost en desarrollo) y la lista de APIs reducida a Maps JavaScript API.
# Sin la variable, la aplicacion usa el mapa de respaldo (Leaflet) como hasta
# ahora.
VITE_GOOGLE_MAPS_API_KEY=
