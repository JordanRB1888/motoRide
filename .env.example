VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000

# Clave de navegador de Google Maps. Es visible en el bundle: lo que la protege
# es la restriccion por referente HTTP en Google Cloud, no el secreto.
# Restringela a https://plus58express.vercel.app/* y http://localhost:3000/*
VITE_GOOGLE_MAPS_BROWSER_KEY=

# Backend (Railway: usa un volumen persistente montado en /data)
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://plus58express.vercel.app
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
DATA_FILE=/data/plus58express.sqlite
UPLOAD_DIR=/data/private-uploads
DISABLE_LEGACY_DEMO_USERS=true

# Clave de servidor de Google Maps, SOLO para Routes API desde el backend.
# Debe ser distinta de la del navegador y restringida por IP. Nunca en el
# repositorio ni en ninguna variable que empiece por VITE_.
GOOGLE_MAPS_SERVER_KEY=
