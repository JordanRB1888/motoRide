VITE_API_URL=http://localhost:4000/api
VITE_SOCKET_URL=http://localhost:4000
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=development
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
VITE_SENTRY_RELEASE=

# Backend (Railway: usa un volumen persistente montado en /data)
PORT=4000
NODE_ENV=production
CLIENT_ORIGIN=https://plus58express.vercel.app
JWT_SECRET=replace-with-at-least-32-random-characters
ADMIN_PASSWORD=replace-with-a-strong-initial-admin-password
DATA_FILE=/data/plus58express.sqlite
UPLOAD_DIR=/data/private-uploads
DISABLE_LEGACY_DEMO_USERS=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_RELEASE=
