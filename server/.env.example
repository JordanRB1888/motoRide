PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATA_FILE=./data/plus58express.sqlite
# Raiz privada de los adjuntos de chat y soporte. Debe estar dentro del mismo
# volumen persistente que DATA_FILE: en Railway, /data/chat-media.
# En produccion es obligatoria; sin ella el proceso no arranca, porque el valor
# por omision caeria en el disco efimero del contenedor.
CHAT_MEDIA_DIR=./data/chat-media
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=admin@58express.com
ADMIN_PASSWORD=change-admin-password
# Zona horaria con la que se calculan el recargo nocturno y la hora pico.
# Es independiente de la zona del servidor; por omisión America/Caracas.
BUSINESS_TIME_ZONE=America/Caracas

# Número EXACTO de proxies inversos por delante del servicio. Railway sitúa uno
# solo, de ahí el 1. Si algún día se antepone una CDN o un balanceador propio,
# este número tiene que subir en la misma medida.
#
# El valor importa en los dos sentidos. Quedarse corto hace que `req.ip` sea la
# dirección del proxy, idéntica para todo el mundo: los limitadores dejan de ser
# por cliente y se convierten en un cupo global, de modo que treinta intentos de
# inicio de sesión en toda la plataforma dejan fuera a los demás. Pasarse permite
# que cualquiera anteponga una dirección inventada en X-Forwarded-For y estrene
# cupo en cada petición.
#
# En desarrollo se deja en 0: sin proxy delante, esa cabecera la escribe el
# propio cliente y no debe creerse. El servidor registra el valor efectivo al
# arrancar (`trust proxy = ...`) para poder verificarlo en el despliegue.
TRUST_PROXY=0
