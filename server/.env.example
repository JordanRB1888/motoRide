PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:3000
DATA_FILE=./data/plus58express.sqlite
# Raiz privada de los adjuntos de chat y soporte. OPCIONAL: si no se define, se
# deriva del directorio de DATA_FILE, que es el volumen persistente (en Railway,
# /data/plus58express.sqlite da /data/chat-media). Solo hace falta declararla
# para colocarlos en otro sitio, y ese sitio debe seguir estando dentro del
# volumen: una ruta fuera se rechaza al arrancar.
# CHAT_MEDIA_DIR=./data/chat-media
JWT_SECRET=change-this-secret-in-production
ADMIN_EMAIL=admin@58express.com
ADMIN_PASSWORD=change-admin-password
# Zona horaria con la que se calculan el recargo nocturno y la hora pico.
# Es independiente de la zona del servidor; por omisión America/Caracas.
BUSINESS_TIME_ZONE=America/Caracas

# Número EXACTO de proxies inversos por delante del servicio. Railway sitúa uno
# solo, de ahí el 1. Si algún día se antepone una CDN o un balanceador propio,
# este número tiene que subir en la misma medida.
#
# El valor importa en los dos sentidos. Quedarse corto hace que `req.ip` sea la
# dirección del proxy, idéntica para todo el mundo: los limitadores dejan de ser
# por cliente y se convierten en un cupo global, de modo que treinta intentos de
# inicio de sesión en toda la plataforma dejan fuera a los demás. Pasarse permite
# que cualquiera anteponga una dirección inventada en X-Forwarded-For y estrene
# cupo en cada petición.
#
# En desarrollo se deja en 0: sin proxy delante, esa cabecera la escribe el
# propio cliente y no debe creerse. El servidor registra el valor efectivo al
# arrancar (`trust proxy = ...`) para poder verificarlo en el despliegue.
TRUST_PROXY=0

# --- Web Push (PUSH-1: infraestructura instalada, apagada) -------------------
# Cualquier valor que no sea 1/true/yes/on cuenta como apagado, y la ausencia
# de la variable tambien. Con la bandera en falso no se registra ninguna
# suscripcion nueva ni se contacta con ningun proveedor; darse de baja SI
# sigue funcionando, porque retirar el consentimiento no puede depender de que
# la funcionalidad este encendida.
WEB_PUSH_ENABLED=false
# Las claves llegan en PUSH-4. Aqui solo quedan documentados los nombres: NO
# se genera ni se guarda material real. La privada jamas puede llevar el
# prefijo VITE_ ni vivir en un .env del frontend, porque Vite la publicaria en
# el bundle.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# Google Routes, SOLO servidor. La usan dos clientes:
#   · el ranking del despacho  (computeRouteMatrix: cuanto tarda cada candidato)
#   · la geometria de la ruta  (computeRoutes: por donde va la linea del mapa)
#
# Tiene que ser una credencial DEDICADA de servidor, restringida por direccion
# IP y limitada a la Routes API. NO sirve ninguna de las claves de Maps del
# movil --Android, iOS o web-- que viajan dentro de la aplicacion y estan
# restringidas por firma o por dominio: aqui las llamadas salen del backend.
#
# Sin ella el servidor NO se cae: mide con su geodesica propia y el mapa no
# dibuja ruta, que es la degradacion honesta. Con ella aparecen las dos cosas.
#
# En desarrollo va en `server/.env`, que git ignora. `npm start` y `npm run dev`
# lo cargan solos si existe.
# --------------------------------------------------------------------------
# Google Maps en el SERVIDOR
# --------------------------------------------------------------------------
#
# Preferido: cuenta de servicio dedicada (OAuth). No depende de la IP publica,
# asi que sobrevive a un cambio de servidor de la VPN sin tocar Google Cloud.
# El fichero NUNCA entra en Git.
# GOOGLE_MAPS_SERVICE_ACCOUNT_FILE=./maps-service-account.json
#
# En PRODUCCION (Railway) no hay fichero que montar: la misma cuenta va aqui en
# base64, en una sola linea. Se decodifica en memoria y jamas se escribe a
# disco. Generarla:  base64 -w0 maps-service-account.json
# GOOGLE_MAPS_SERVICE_ACCOUNT_B64=
#
# El alcance solo se toca si Google publica uno mas estrecho que sirva para
# Routes y Places; hoy solo funciona `cloud-platform` (comprobado contra la API).
# GOOGLE_MAPS_OAUTH_SCOPE=https://www.googleapis.com/auth/cloud-platform
#
# RESPALDO: clave de API restringida por IP. Se usa solo si no hay cuenta de
# servicio, y entonces cada cambio de IP exige actualizar la lista en Google
# Cloud. La geocodificacion clasica NO acepta OAuth y necesita esta clave.
# DISPATCH_ROUTES_API_KEY=

# Firebase Cloud Messaging, SOLO servidor (PUSH-1). Ruta al JSON de la cuenta
# de servicio de Firebase. Por omision `server/fcm-service-account.json`, que
# git ignora. Nunca se pega el JSON en una variable: acaba mal escapado y en un
# registro. Sin fichero, FCM queda apagado y nada se cae.
# FCM_SERVICE_ACCOUNT_FILE=./fcm-service-account.json
