datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  PASSENGER
  DRIVER
  ADMIN
}

enum DriverStatus {
  OFFLINE
  AVAILABLE
  BUSY
}

enum TripStatus {
  DRAFT
  SEARCHING
  DRIVER_ASSIGNED
  DRIVER_EN_ROUTE
  DRIVER_ARRIVED
  IN_TRIP
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  PAGO_MOVIL
  CASH_USD
  WALLET
  ZELLE
  ZINLI
}

model User {
  id            String         @id @default(uuid())
  email         String?        @unique
  phone         String         @unique
  passwordHash  String
  firstName     String
  lastName      String
  role          Role           @default(PASSENGER)
  photoUrl      String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  driverProfile DriverProfile?
  riderProfile  RiderProfile?
  tripsAsPassenger Trip[]      @relation("PassengerTrips")
  tripsAsDriver    Trip[]      @relation("DriverTrips")
  notifications    Notification[]

  @@map("users")
}

model DriverProfile {
  id            String       @id @default(uuid())
  userId        String       @unique
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  status        DriverStatus @default(OFFLINE)
  vehicleBrand  String       @default("Bera")
  vehicleModel  String       @default("SBR 150")
  vehiclePlate  String
  vehicleColor  String       @default("Negro")
  rating        Float        @default(5.0)
  totalTrips    Int          @default(0)
  licenseUrl    String?      @default("approved")
  rcvUrl        String?      @default("approved")
  medicalCertUrl String?     @default("approved")
  lastLat       Float?
  lastLng       Float?
  lastHeading   Float?
  lastHeartbeat DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  locationLogs  DriverLocationLog[]

  @@map("driver_profiles")
}

model RiderProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  walletBalance Float    @default(0.0)
  rating        Float    @default(5.0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("rider_profiles")
}

model Trip {
  id              String        @id @default(uuid())
  passengerId     String
  passenger       User          @relation("PassengerTrips", fields: [passengerId], references: [id])
  driverId        String?
  driver          User?         @relation("DriverTrips", fields: [driverId], references: [id])
  status          TripStatus    @default(DRAFT)
  pickupAddress   String
  pickupLat       Float
  pickupLng       Float
  destAddress     String
  destLat         Float
  destLng         Float
  distanceKm      Float
  durationMin     Float
  fareEUR         Float
  fareVES         Float
  paymentMethod   PaymentMethod @default(PAGO_MOVIL)
  acceptedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("trips")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  message   String
  category  String   @default("SYSTEM")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@map("notifications")
}

model DriverLocationLog {
  id        String        @id @default(uuid())
  driverId  String
  driver    DriverProfile @relation(fields: [driverId], references: [id], onDelete: Cascade)
  lat       Float
  lng       Float
  heading   Float?        @default(0)
  createdAt DateTime      @default(now())

  @@map("driver_location_logs")
}
