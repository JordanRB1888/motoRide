# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android

# Comprobacion local del bundle (`npm run bundle:check`). Es un artefacto de
# verificacion, no una fuente.
.expo-bundle-check/
.expo-bundle-ios/

# Configuracion local del backend al que apunta la app. NUNCA se sube: cada
# persona apunta a su propio servidor de desarrollo, y un `.env` compartido
# acabaria apuntando al de alguien mas.
.env
