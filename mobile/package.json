  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "typecheck": "tsc --noEmit",
    "revisar": "node --watch --watch-path=theme --watch-path=preview --watch-path=scripts --watch-path=ui --import ./test/resolver.mjs scripts/servidorDeRevision.mjs",
