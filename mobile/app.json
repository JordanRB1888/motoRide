{
  "expo": {
    "name": "+58Express",
    "slug": "plus58express",
    "scheme": "plus58express",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0e0d0b",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0e0d0b"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.plus58express.app"
    },
    "android": {
      "package": "com.plus58express.app",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0e0d0b"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "react-native-maps"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
